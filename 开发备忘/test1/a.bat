 @echo offchcp 65001 >nulset DESKTOP=%USERPROFILE%\Desktopecho Generating test text files on Desktop...:: 1MBpowershell -Command ^"$f='%DESKTOP%\test_1MB.txt'; $s='ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ' * 100; ^while ((Get-Item $f -ErrorAction SilentlyContinue).Length -lt 1MB) { Add-Content -Path $f -Value $s -Encoding UTF8 }":: 2MBpowershell -Command ^"$f='%DESKTOP%\test_2MB.txt'; $s='ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ' * 100; ^while ((Get-Item $f -ErrorAction SilentlyContinue).Length -lt 2MB) { Add-Content -Path $f -Value $s -Encoding UTF8 }":: 5MBpowershell -Command ^"$f='%DESKTOP%\test_5MB.txt'; $s='ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ' * 100; ^while ((Get-Item $f -ErrorAction SilentlyContinue).Length -lt 5MB) { Add-Content -Path $f -Value $s -Encoding UTF8 }":: 10MBpowershell -Command ^"$f='%DESKTOP%\test_10MB.txt'; $s='ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ' * 100; ^while ((Get-Item $f -ErrorAction SilentlyContinue).Length -lt 10MB) { Add-Content -Path $f -Value $s -Encoding UTF8 }":: 50MBpowershell -Command ^"$f='%DESKTOP%\test_50MB.txt'; $s='ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789 ' * 100; ^while ((Get-Item $f -ErrorAction SilentlyContinue).Length -lt 50MB) { Add-Content -Path $f -Value $s -Encoding UTF8 }"echo Done.pause