{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TXT Editor",
  "mainBinaryName": "TXT Editor",
  "version": "0.1.0",
  "identifier": "com.txt-editor-tauri",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },

  "app": {
    "windows": [
      {
        "title": "TXT Editor",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true,
        "minWidth": 500,
        "minHeight": 400,
        "devtools": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["txt"],
        "name": "Text File",
        "description": "Text File",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
