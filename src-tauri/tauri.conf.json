{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinchPad",
  "mainBinaryName": "FinchPad",
  "version": "0.3.0",
  "identifier": "com.finchpad.desktop",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },

  "app": {
    "windows": [
      {
        "title": "FinchPad",
        "width": 800,
        "height": 600,
        "dragDropEnabled": true,
        "minWidth": 500,
        "minHeight": 400,
        "devtools": true,
        "visible": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "log", "md", "markdown", "rst", 
          "json", "jsonc", "xml", "yaml", "yml", "toml", "ini", "conf", "cfg", "env", "properties", "csv", "tsv", 
          "html", "htm", "xhtml", "css", "scss", "less", 
          "js", "mjs", "cjs", "jsx", "ts", "tsx", "vue", "svelte", 
          "py", "pyw", "java", "c", "h", "cpp", "cc", "cxx", "hpp", "cs", "go", "rs", "rb", "php", "swift", "kt", "kts", "scala", "lua", "pl", "r", "dart", 
          "sh", "bash", "zsh", "bat", "cmd", "ps1", "vbs", 
          "sql", "tex", "diff", "patch", "gitignore", "dockerfile", "mk", "gradle", "proto"
        ],
        "name": "Text File",
        "description": "Text File",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
