{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "FinchPad",
    "mainBinaryName": "FinchPad",
    "version": "0.5.0",
    "identifier": "com.finchpad.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "FinchPad",
                "width": 800,
                "height": 600,
                "dragDropEnabled": true,
                "minWidth": 500,
                "minHeight": 400,
                "devtools": true,
                "visible": false,
                "decorations": false,
                "transparent": true
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "fileAssociations": [
            {
                "ext": [
                    "txt",
                    "log",
                    "md",
                    "markdown",
                    "rst",
                    "json",
                    "jsonc",
                    "xml",
